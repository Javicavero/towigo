{
  "name": "owi-anim-studio",
  "private": true,
  "description": "Estudio de animación de Owi: renderiza el modelo 3D fotograma a fotograma y genera las hojas de sprites (assets/owi/anim).",
  "scripts": {
    "build": "esbuild src/entry.tsx --bundle --outfile=bundle.js --format=iife --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --minify",
    "serve": "python3 -m http.server 8790",
    "render": "./renderall.sh && python3 sheets.py"
  },
  "dependencies": { "react": "19.1.0", "react-dom": "19.1.0", "@react-three/fiber": "9.3.0", "three": "0.170.0", "esbuild": "0.25.0" }
}
